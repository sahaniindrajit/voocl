<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="vocl"
        Arguments=""
        InstallLocation="C:\Program Files\Indrajit Sahani\Vocl">
    </Installer>
    <PackageInformation
        PackageName="Vocl"
        PackageDisplayName="Vocl"
        PublisherName="CN=Indrajit Sahani"
        PublisherDisplayName="Indrajit Sahani"
        Version="0.1.0.0"
        PackageDescription="Open-source BYOK voice dictation">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.sahaniindrajit.vocl"
                Description="Open-source BYOK voice dictation"
                DisplayName="Vocl"
                ExecutableName="vocl"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Vocl</DisplayName>
            <PublisherDisplayName>Indrajit Sahani</PublisherDisplayName>
            <Description>Open-source BYOK voice dictation</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="vocl.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
